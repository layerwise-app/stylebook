{
  "$description": "Tidewell design tokens. Generated from the brand config.",
  "color": {
    "fathom": {
      "$type": "color",
      "$value": "#08262A",
      "$description": "All text on light grounds. Deep fields and can bases.",
      "$extensions": {
        "name": "Fathom",
        "role": "ink",
        "rgb": "rgb(8, 38, 42)",
        "hsl": "hsl(187, 68%, 10%)",
        "oklch": "oklch(0.249 0.035 207.5)",
        "cmyk": "85 / 55 / 60 / 75",
        "pantone": "PANTONE 5477 C"
      }
    },
    "salt": {
      "$type": "color",
      "$value": "#F7F3E8",
      "$description": "The default ground. Reads as uncoated label stock.",
      "$extensions": {
        "name": "Salt",
        "role": "paper",
        "rgb": "rgb(247, 243, 232)",
        "hsl": "hsl(44, 48%, 94%)",
        "oklch": "oklch(0.964 0.015 90.2)",
        "cmyk": "3 / 3 / 10 / 0"
      }
    },
    "peel": {
      "$type": "color",
      "$value": "#FF5C35",
      "$description": "The cap and full-bleed fields. Set Fathom on it, never Salt.",
      "$extensions": {
        "name": "Peel",
        "role": "brand",
        "rgb": "rgb(255, 92, 53)",
        "hsl": "hsl(12, 100%, 60%)",
        "oklch": "oklch(0.686 0.205 34.6)",
        "cmyk": "0 / 80 / 85 / 0",
        "pantone": "PANTONE 171 C"
      }
    },
    "tidewater": {
      "$type": "color",
      "$value": "#0A4A48",
      "$description": "The tide inside the cap. Second field color on packs.",
      "$extensions": {
        "name": "Tidewater",
        "role": "accent",
        "rgb": "rgb(10, 74, 72)",
        "hsl": "hsl(178, 76%, 16%)",
        "oklch": "oklch(0.372 0.06 191.6)",
        "cmyk": "90 / 45 / 65 / 40"
      }
    },
    "seaglass": {
      "$type": "color",
      "$value": "#B4DCCB",
      "$description": "Quiet fields, charts, and the Dry label.",
      "$extensions": {
        "name": "Seaglass",
        "role": "support",
        "rgb": "rgb(180, 220, 203)",
        "hsl": "hsl(154, 36%, 78%)",
        "oklch": "oklch(0.861 0.048 167.5)"
      }
    },
    "quinine": {
      "$type": "color",
      "$value": "#E8F27A",
      "$description": "Sparing highlight. Tonic glows under UV light; this is that glow.",
      "$extensions": {
        "name": "Quinine",
        "role": "support",
        "rgb": "rgb(232, 242, 122)",
        "hsl": "hsl(65, 82%, 71%)",
        "oklch": "oklch(0.929 0.144 113.1)"
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "\"Young Serif\", Georgia, \"Times New Roman\", serif"
    },
    "text": {
      "$type": "fontFamily",
      "$value": "\"Instrument Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "\"DM Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 400,
        "fontSize": "128px",
        "lineHeight": 0.98,
        "letterSpacing": "-0.02em"
      },
      "$description": "Can fronts, posters, and opening spreads. One per layout."
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 400,
        "fontSize": "72px",
        "lineHeight": 1.04,
        "letterSpacing": "-0.015em"
      },
      "$description": "Page and slide titles."
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 400,
        "fontSize": "38px",
        "lineHeight": 1.14,
        "letterSpacing": "-0.01em"
      },
      "$description": "Sections and pull quotes."
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.text}",
        "fontWeight": 600,
        "fontSize": "21px",
        "lineHeight": 1.32,
        "letterSpacing": "-0.005em"
      },
      "$description": "Intro lines and card titles."
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.text}",
        "fontWeight": 400,
        "fontSize": "17px",
        "lineHeight": 1.55,
        "letterSpacing": "0em"
      },
      "$description": "Paragraphs. Keep lines under 70 characters."
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.text}",
        "fontWeight": 400,
        "fontSize": "14px",
        "lineHeight": 1.45,
        "letterSpacing": "0em"
      },
      "$description": "Captions and legal lines."
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontWeight": 500,
        "fontSize": "12px",
        "lineHeight": 1.35,
        "letterSpacing": "0.04em"
      },
      "$description": "Volumes, dates, and labels. Uppercase only here."
    }
  },
  "space": {
    "hair": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Between a label and its value."
    },
    "sip": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Inside tight groups."
    },
    "splash": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Between list rows."
    },
    "pour": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Default gap between related items."
    },
    "glass": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Padding inside a field."
    },
    "can": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "Between groups."
    },
    "crate": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "Between blocks."
    },
    "shelf": {
      "$type": "dimension",
      "$value": "64px",
      "$description": "Page margins on large layouts."
    },
    "tide": {
      "$type": "dimension",
      "$value": "96px",
      "$description": "Between major sections."
    },
    "sound": {
      "$type": "dimension",
      "$value": "128px",
      "$description": "Opening space on a spread."
    }
  }
}
